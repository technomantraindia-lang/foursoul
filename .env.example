APP_NAME=Foursouls
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost
SAAS_ENABLED=false
TEST_CENTER_ENABLED=false
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Business timezone for display/scheduling (Prompt 1, Step 13)
BUSINESS_TIMEZONE=Asia/Dubai

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---- Database (MySQL 8+) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=foursouls
DB_USERNAME=root
DB_PASSWORD=

# ---- Redis (production recommended; safe file fallback locally) ----
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
FILESYSTEM_DISK=local

# ---- Mail ----
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

# ---- Filesystem / AWS (S3 optional) ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---- Payments (gateway chosen in later phase; no credentials here) ----
PAYMENT_GATEWAY=

# ---- WATI integration (later phase) ----
WATI_BASE_URL=
WATI_API_KEY=
WATI_ENDPOINT=

# ---- YouTube / Google (later phases) ----
YOUTUBE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ---- Social login (later phase) ----
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=

# ---- Firebase (push notifications, later phase) ----
FIREBASE_CREDENTIALS=
FIREBASE_PROJECT_ID=

# ---- AI provider (later phase) ----
AI_PROVIDER=
AI_API_KEY=

# ---- GeoIP (trusted source abstraction; Prompt 1 Step 7) ----
# Supported drivers: none | cloudflare | geoip_provider
GEOIP_DRIVER=none
GEOIP_PROVIDER_API_KEY=
GEOIP_TRUST_CF_HEADER=false
