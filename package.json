{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "npm --prefix frontend install && npm --prefix frontend run build && vite build",
        "build:laravel": "vite build",
        "build:frontend": "npm --prefix frontend install && npm --prefix frontend run build",
        "start": "npx serve -s frontend/dist -l $PORT",
        "dev": "vite"
    },
    "dependencies": {
        "serve": "^14.2.4"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    }
}
